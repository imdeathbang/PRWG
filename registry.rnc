datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"

minus_text = xsd:string { pattern = "[a-z]+" }
screaming_snake_case = xsd:string { pattern = "[A-Z]+(_[A-Z]+)*" }

Param = element param {
    attribute type { text },
    attribute name { text }
}

Constructor = element constructor {
    Param*
}

Handle = element handle {
    attribute name { text },
    Constructor,
}

Enum = element enum {
    attribute value { xsd:integer },
    attribute name { screaming_snake_case }
}

Result = element result {
    element success {
        attribute value { xsd:integer },
        attribute name { screaming_snake_case }
    },
    Enum*
}

element registry {
    attribute namespace { minus_text },
    attribute diminutive { minus_text },
    Result,
    Handle+
}