<?xml version="1.0" encoding="UTF-8"?>
<registry namespace="velix" diminutive = "vl" prefix="Vl">
    <result>
        <success value="0" name="SUCCESS"/>
        <enum value="1" name="FAILURE"/>
    </result>
    <handle name="Window">
        <constructor>
            <param type="string" name="title"/>
            <param type="int" name="width"/>
        </constructor>
        <destructor/>
        <property type="int" name="width">
            <get name="vlGetWindowWidth"/>
            <set name="vlSetWindowWidth"/>
        </property>
        <command type="void" name="Show">
            <param type="bool" name="show"/>
        </command>
        <command type="string" name="vlGetPip"/>
    </handle>
    <enum type="int" name="VlResult">
        <enumerator name="VL_SUCCESS" value="0"/>
        <enumerator name="VL_FAIL" value="1"/>
    </enum>
    <handle type="VlTest" name="test">
        <constructor command="vlCreateTest"/>
        <destructor command="vlDestroyTest"/>
    </handle>
</registry>